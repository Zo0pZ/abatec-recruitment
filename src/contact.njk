---
layout: layouts/base.njk
title: "Contact"
description: "Get in touch with Abatec — call, email, or send a consultation request directly to our team."
---
<header class="page-header">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> / Contact</p>
    <span class="eyebrow">Contact</span>
    <h1>Let's talk about your next hire, or your next role.</h1>
    <p>Call, email, or send us the details below and the right consultant will come back to you directly.</p>
  </div>
</header>

<section>
  <div class="container">
    <div class="grid" style="grid-template-columns: 0.9fr 1.4fr; gap: 3rem; align-items:flex-start;">
      <div>
        <div class="card" style="margin-bottom:1.5rem;">
          <h3>Call us</h3>
          <p><a href="tel:{{ site.phoneLink }}" style="color:var(--amber-500);font-weight:700;font-size:1.1rem;">{{ site.phone }}</a></p>
          <p>Monday&ndash;Friday, 8:30am&ndash;5:30pm</p>
        </div>
        <div class="card" style="margin-bottom:1.5rem;">
          <h3>Email us</h3>
          <p><a href="mailto:{{ site.email }}" style="color:var(--amber-500);font-weight:700;">{{ site.email }}</a></p>
        </div>
        <div class="card">
          <h3>Visit us</h3>
          <address style="font-style:normal;color:var(--slate-500);">
            {{ site.address.line1 }}<br>
            {{ site.address.line2 }}<br>
            {{ site.address.city }} {{ site.address.postcode }}<br>
            {{ site.address.country }}
          </address>
          <div class="hero__art" style="margin-top:1rem;aspect-ratio:16/9;background:var(--slate-100);" role="img" aria-label="Map showing Abatec's office location in Bristol"></div>
        </div>
      </div>

      <div class="form-panel">
        <div class="form-success" id="contact-success" role="status">
          <strong>Thank you &mdash; your message has been sent.</strong> A member of our team will be in touch shortly.
        </div>
        <form data-demo-form data-success-target="contact-success" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="c-name">Full name *</label>
              <input type="text" id="c-name" name="name" required autocomplete="name">
            </div>
            <div class="field">
              <label for="c-email">Email address *</label>
              <input type="email" id="c-email" name="email" required autocomplete="email">
            </div>
            <div class="field">
              <label for="c-phone">Phone number</label>
              <input type="tel" id="c-phone" name="phone" autocomplete="tel">
            </div>
            <div class="field">
              <label for="c-enquiry">I am a... *</label>
              <select id="c-enquiry" name="enquiryType" required>
                <option value="" disabled selected>Select one</option>
                <option value="client">Client looking to hire</option>
                <option value="candidate">Candidate looking for a role</option>
                <option value="press">Press / media enquiry</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="field field--full">
              <label for="c-message">Message *</label>
              <textarea id="c-message" name="message" required placeholder="Tell us a bit about what you need."></textarea>
            </div>
          </div>
          <button class="btn btn--primary btn--block" type="submit" style="margin-top:1.5rem;">Send message</button>
        </form>
      </div>
    </div>
  </div>
</section>
