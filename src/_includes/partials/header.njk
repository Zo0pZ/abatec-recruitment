<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="{{ site.name }} home">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <rect x="2" y="18" width="6" height="16" fill="#C9A227"/>
        <rect x="11" y="10" width="6" height="24" fill="#E7EAEE"/>
        <rect x="20" y="4" width="6" height="30" fill="#E7EAEE"/>
        <rect x="29" y="14" width="5" height="20" fill="#C9A227"/>
      </svg>
      <span class="site-header__wordmark">Abatec</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span class="sr-only">Menu</span>
        <span class="site-nav__burger" aria-hidden="true"></span>
      </button>
      <ul class="site-nav__list" id="primary-nav">
        {% for item in site.primaryNav %}
        <li class="site-nav__item{% if item.children %} has-children{% endif %}">
          <a href="{{ item.url }}">{{ item.label }}</a>
          {% if item.children %}
          <ul class="site-nav__submenu">
            {% for child in item.children %}
            <li><a href="{{ child.url }}">{{ child.label }}</a></li>
            {% endfor %}
          </ul>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--ghost btn--small" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
      <a class="btn btn--primary btn--small" href="/for-candidates/register/">Register your CV</a>
    </div>
  </div>
</header>
