<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <span class="site-footer__wordmark">Abatec</span>
      <p>{{ site.strapline }}</p>
      <ul class="site-footer__social" aria-label="Social media">
        <li><a href="{{ site.social.linkedin }}">LinkedIn</a></li>
        <li><a href="{{ site.social.twitter }}">X / Twitter</a></li>
        <li><a href="{{ site.social.facebook }}">Facebook</a></li>
        <li><a href="{{ site.social.instagram }}">Instagram</a></li>
      </ul>
    </div>

    <nav class="site-footer__col" aria-label="For clients">
      <h2>For Clients</h2>
      <ul>
        <li><a href="{{ '/for-clients/' | url }}">Our Services</a></li>
        <li><a href="{{ '/for-clients/sectors/' | url }}">Sector Expertise</a></li>
        <li><a href="{{ '/for-clients/case-studies/' | url }}">Case Studies</a></li>
        <li><a href="{{ '/contact/' | url }}">Request a Consultation</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="For candidates">
      <h2>For Candidates</h2>
      <ul>
        <li><a href="{{ '/for-candidates/jobs/' | url }}">Job Search</a></li>
        <li><a href="{{ '/for-candidates/support/' | url }}">Candidate Support</a></li>
        <li><a href="{{ '/for-candidates/register/' | url }}">Register Your CV</a></li>
      </ul>
    </nav>

    <nav class="site-footer__col" aria-label="Company">
      <h2>Company</h2>
      <ul>
        <li><a href="{{ '/about/our-story/' | url }}">Our Story</a></li>
        <li><a href="{{ '/about/team/' | url }}">Meet the Team</a></li>
        <li><a href="{{ '/about/awards/' | url }}">Awards &amp; Accreditations</a></li>
        <li><a href="{{ '/careers/' | url }}">Careers</a></li>
        <li><a href="{{ '/acquisitions/' | url }}">Acquisitions</a></li>
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2>Get in touch</h2>
      <address>
        {{ site.address.line1 }}<br>
        {{ site.address.line2 }}<br>
        {{ site.address.city }}<br>
        {{ site.address.postcode }}
      </address>
      <p><a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p style="margin-top:0.75rem;font-size:0.85rem;color:var(--slate-500);">Also in Bristol &amp; Cardiff — see <a href="{{ '/contact/' | url }}">Contact</a></p>
    </div>
  </div>

  <div class="site-footer__accreditations container">
    {% for a in site.accreditations %}
    <span class="accreditation-badge" title="{{ a.description }}">{{ a.name }}</span>
    {% endfor %}
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {% year %} {{ site.legalName }}. Registered in England, company no. {{ site.companyNumber }}.</p>
    <ul>
      <li><a href="https://abatec.co.uk/privacy-policy/">Privacy Policy</a></li>
      <li><a href="https://abatec.co.uk/terms-and-conditions/">Terms &amp; Conditions</a></li>
      <li><a href="{{ '/contact/' | url }}">Contact</a></li>
      <li><a href="#main">Back to top</a></li>
    </ul>
  </div>
</footer>
