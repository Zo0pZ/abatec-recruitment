---
layout: layouts/base.njk
title: "Job Search"
description: "Search live engineering, industrial, civil and IT vacancies across the UK South West with Abatec."
---
<header class="page-header">
  <div class="container">
    <p class="breadcrumb"><a href="{{ '/' | url }}">Home</a> / <a href="{{ '/for-candidates/jobs/' | url }}">For Candidates</a> / Job Search</p>
    <span class="eyebrow">For Candidates</span>
    <h1>Find your next role.</h1>
    <p>{{ jobs.length }} live vacancies across engineering, industrial, civil and IT — filter by sector, location, contract type or keyword.</p>
  </div>
</header>

<section>
  <div class="container" data-job-board>
    <form class="job-search" role="search" aria-label="Job search filters">
      <div class="job-search__grid">
        <div class="field">
          <label for="keyword">Keyword</label>
          <input type="text" id="keyword" name="keyword" placeholder="Job title or skill, e.g. &quot;site manager&quot;">
        </div>
        <div class="field">
          <label for="sector">Sector</label>
          <select id="sector" name="sector">
            <option value="">All sectors</option>
            {% for sector in sectors %}
            <option value="{{ sector.name }}">{{ sector.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="location">Location</label>
          <select id="location" name="location">
            <option value="">All locations</option>
            <option value="Bristol">Bristol</option>
            <option value="Exeter">Exeter</option>
            <option value="Plymouth">Plymouth</option>
            <option value="Swindon">Swindon</option>
          </select>
        </div>
        <div class="field">
          <label for="contract">Contract Type</label>
          <select id="contract" name="contract">
            <option value="">All types</option>
            <option value="Permanent">Permanent</option>
            <option value="Contract">Contract</option>
            <option value="Temporary">Temporary</option>
          </select>
        </div>
        <div class="field" style="justify-content:flex-end;">
          <button type="submit" class="btn btn--primary">Search</button>
        </div>
      </div>
    </form>

    <div class="job-results__meta">
      <span data-job-count>{{ jobs.length }} roles found</span>
      <span>Updated weekly · can't see the right role? <a href="{{ '/for-candidates/register/' | url }}" style="color:var(--amber-500);font-weight:600;">Register your CV</a></span>
    </div>

    {% for job in jobs %}
    <article class="job-card" data-job-card
      data-title="{{ job.title }}"
      data-summary="{{ job.summary }}"
      data-sector="{{ job.sector }}"
      data-location="{{ job.location }}"
      data-contract="{{ job.contract }}">
      <div>
        <h3>{{ job.title }}</h3>
        <p>{{ job.summary }}</p>
        <div class="job-card__meta">
          <span>{{ job.location }}</span>
          <span>{{ job.sector }}</span>
          <span>{{ job.contract }}</span>
          <span>Ref: {{ job.ref }}</span>
        </div>
      </div>
      <div class="text-center">
        <p class="job-card__salary">
          {% if job.contract == "Permanent" %}
            {{ job.salaryMin | currency }}&ndash;{{ job.salaryMax | currency }}/yr
          {% else %}
            {{ job.salaryMin | currency }}&ndash;{{ job.salaryMax | currency }}/day
          {% endif %}
        </p>
        <a class="btn btn--secondary btn--small" href="{{ '/for-candidates/register/' | url }}?ref={{ job.ref }}">Quick Apply</a>
      </div>
    </article>
    {% endfor %}

    <div class="job-empty" data-job-empty>
      <h3>No roles match those filters yet.</h3>
      <p>Try widening your search, or register your CV so we can reach out when the right role comes in.</p>
      <a class="btn btn--primary" href="{{ '/for-candidates/register/' | url }}">Register your CV</a>
    </div>
  </div>
</section>

<section class="section--slate">
  <div class="container">
    <div class="cta-band">
      <div>
        <h2>Not ready to apply, but want first look at new roles?</h2>
        <p>Register your CV once and we'll match you to relevant vacancies as they land.</p>
      </div>
      <a class="btn btn--primary" href="{{ '/for-candidates/register/' | url }}">Register your CV</a>
    </div>
  </div>
</section>
